{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "Enabled": true,
    "BootstrapServers": "localhost:9092",
    "ClientId": "marketdata-ingestor",
    "PublishSampleOnStartup": false,
    "TestConsumer": {
      "Enabled": false,
      "Topic": "raw-market-trades",
      "GroupId": "marketdata-ingestor-test-consumer",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": true
    },
    "Resilience": {
      "Enabled": true,
      "MaxRetryAttempts": 5,
      "BaseDelayMilliseconds": 250,
      "MaxDelayMilliseconds": 5000,
      "JitterMilliseconds": 250
    }
  },
  "Binance": {
    "Endpoint": "wss://stream.binance.com:9443/stream",
    "Symbols": [ "btcusdt", "ethusdt", "solusdt" ],
    "ReconnectDelaySeconds": 5,
    "MaxReconnectDelaySeconds": 60,
    "ReconnectJitterSeconds": 2,
    "ReceiveBufferSize": 65536
  },
  "Ingestor": {
    "KafkaTopic": "raw-market-trades",
    "RetryTopic": "raw-market-trades-retry",
    "DeadLetterTopic": "raw-market-trades-dlq"
  }
}

