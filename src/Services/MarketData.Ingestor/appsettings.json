{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "ClientId": "marketdata-ingestor",
    "Resilience": {
      "Enabled": true,
      "MaxRetryAttempts": 5,
      "BaseDelayMilliseconds": 250,
      "MaxDelayMilliseconds": 5000,
      "JitterMilliseconds": 250
    }
  },
  "Binance": {
    "Endpoint": "wss://stream.binance.com:9443/stream",
    "Symbols": [
      "btcusdt",
      "ethusdt",
      "solusdt",
      "bnbusdt",
      "xrpusdt",
      "adausdt",
      "dogeusdt",
      "maticusdt",
      "dotusdt",
      "shibusdt",
      "ltcusdt",
      "avaxusdt",
      "linkusdt",
      "atomusdt",
      "trxusdt"
    ],
    "ReconnectDelaySeconds": 5,
    "MaxReconnectDelaySeconds": 60,
    "ReconnectJitterSeconds": 2,
    "ReceiveBufferSize": 65536
  },
  "Ingestor": {
    "KafkaTopic": "raw-market-trades",
    "RetryTopic": "raw-market-trades-retry",
    "DeadLetterTopic": "raw-market-trades-dlq",
    "ThroughputLogIntervalSeconds": 30
  }
}

