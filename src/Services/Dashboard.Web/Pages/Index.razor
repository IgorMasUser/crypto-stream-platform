@page "/"
@inject TradingApp.Dashboard.Web.Services.AnalyticsService AnalyticsService
@implements IAsyncDisposable

<PageTitle>TradingApp Dashboard</PageTitle>

<div style="padding: 16px 20px; background:#1a1a2e; color:#e0e0e0; min-height:100vh; font-family:'Segoe UI',sans-serif;">

    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
        <div>
            <h2 style="margin:0; color:#00d4ff; font-size:1.6rem;">📈 TradingApp Dashboard</h2>
            <small style="color:#888;">
                @if (_lastUpdated.HasValue)
                {
                    <span>Last updated: @_lastUpdated.Value.ToLocalTime().ToString("HH:mm:ss") &nbsp;|&nbsp; @_items.Count records</span>
                }
            </small>
        </div>
        <div style="display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <label style="color:#aaa; font-size:0.85rem; margin:0;">
                <input type="checkbox" @bind="_autoRefresh" @bind:after="OnAutoRefreshChangedAsync" />
                &nbsp;Auto-refresh (@_autoRefreshSec s)
            </label>
            <button class="btn btn-sm btn-outline-light" @onclick="Load" disabled="@_loading">
                @(_loading ? "Loading…" : "⟳ Refresh")
            </button>
            <button class="btn btn-sm btn-outline-danger" @onclick="Clear" disabled="@(_clearing || _loading)">
                @(_clearing ? "Clearing…" : "🗑 Clear index")
            </button>
        </div>
    </div>

    <div style="display:flex; gap:12px; margin-bottom:16px; flex-wrap:wrap; align-items:flex-end;">
        <div>
            <label style="color:#aaa; font-size:0.8rem; display:block; margin-bottom:4px;">Symbol</label>
            <select style="background:#16213e; color:#e0e0e0; border:1px solid #444; border-radius:4px; padding:4px 8px;"
                    @bind="_selectedSymbol" @bind:after="Load">
                <option value="">All symbols</option>
                @foreach (var s in _symbols)
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div>
            <label style="color:#aaa; font-size:0.8rem; display:block; margin-bottom:4px;">Rows</label>
            <select style="background:#16213e; color:#e0e0e0; border:1px solid #444; border-radius:4px; padding:4px 8px;"
                    @bind="_pageSize" @bind:after="Load">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="200">200</option>
            </select>
        </div>
        <div>
            <label style="color:#aaa; font-size:0.8rem; display:block; margin-bottom:4px;">Sort by</label>
            <select style="background:#16213e; color:#e0e0e0; border:1px solid #444; border-radius:4px; padding:4px 8px;"
                    @bind="_sortField" @bind:after="ApplySort">
                <option value="windowStartUtc">Window Start ↓ (newest)</option>
                <option value="symbol">Symbol</option>
                <option value="lastPrice">Last Price</option>
                <option value="volume">Volume</option>
                <option value="tradesCount">Trades</option>
            </select>
        </div>
    </div>

    @if (_error is not null)
    {
        <div style="color:#f44336; background:#2a0a0a; border:1px solid #f44336; border-radius:4px; padding:10px 14px; margin-bottom:12px;">
            ⚠ Error: @_error
        </div>
    }

    @if (_loading && _items.Count == 0)
    {
        <p style="color:#888;">Loading...</p>
    }
    else if (_items.Count == 0)
    {
        <p style="color:#888;">No data. Make sure the pipeline is running.</p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                <thead>
                    <tr style="background:#16213e; color:#00d4ff; text-align:right;">
                        <th style="text-align:left; padding:8px 10px;">Symbol</th>
                        <th style="padding:8px 10px;">Open</th>
                        <th style="padding:8px 10px; color:#4caf50;">High</th>
                        <th style="padding:8px 10px; color:#f44336;">Low</th>
                        <th style="padding:8px 10px; color:#fff;">Last</th>
                        <th style="padding:8px 10px;">Volume</th>
                        <th style="padding:8px 10px;">Trades</th>
                        <th style="padding:8px 10px; text-align:left;">Window Start (UTC)</th>
                        <th style="padding:8px 10px; text-align:left;">Window End (UTC)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var x in _sortedItems)
                    {
                        var priceColor = x.LastPrice >= x.OpenPrice ? "#4caf50" : "#f44336";
                        <tr style="border-bottom:1px solid #2a2a4a;" @key="@($"{x.Symbol}|{x.WindowStartUtc:O}")">
                            <td style="padding:6px 10px; font-weight:600; color:#00d4ff;">@x.Symbol</td>
                            <td style="padding:6px 10px; text-align:right; color:#ccc;">@x.OpenPrice.ToString("F2")</td>
                            <td style="padding:6px 10px; text-align:right; color:#4caf50;">@x.HighPrice.ToString("F2")</td>
                            <td style="padding:6px 10px; text-align:right; color:#f44336;">@x.LowPrice.ToString("F2")</td>
                            <td style="padding:6px 10px; text-align:right; font-weight:600; color:@priceColor;">@x.LastPrice.ToString("F2")</td>
                            <td style="padding:6px 10px; text-align:right; color:#ccc;">@x.Volume.ToString("F4")</td>
                            <td style="padding:6px 10px; text-align:right; color:#ccc;">@x.TradesCount</td>
                            <td style="padding:6px 10px; color:#888; font-size:0.8rem;">@x.WindowStartUtc.ToString("MM/dd HH:mm:ss")</td>
                            <td style="padding:6px 10px; color:#888; font-size:0.8rem;">@x.WindowEndUtc.ToString("MM/dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _clearing = false;
    private bool _autoRefresh = false;
    private int _autoRefreshSec = 10;
    private int _pageSize = 100;
    private string _selectedSymbol = "";
    private string _sortField = "windowStartUtc";
    private DateTime? _lastUpdated;
    private string? _error;
    private List<TradingApp.Contracts.Events.AggregatedMarketAnalyticsEvent> _items = new();
    private List<string> _symbols = new();
    private CancellationTokenSource? _autoRefreshCts;

    private IEnumerable<TradingApp.Contracts.Events.AggregatedMarketAnalyticsEvent> _sortedItems =>
        _sortField switch
        {
            "symbol"      => _items.OrderBy(x => x.Symbol),
            "lastPrice"   => _items.OrderByDescending(x => x.LastPrice),
            "volume"      => _items.OrderByDescending(x => x.Volume),
            "tradesCount" => _items.OrderByDescending(x => x.TradesCount),
            _             => _items
        };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _symbols = (await AnalyticsService.GetSymbolsAsync()).OrderBy(s => s).ToList();
            await Load();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
        }
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        try
        {
            var symbol = string.IsNullOrWhiteSpace(_selectedSymbol) ? null : _selectedSymbol;
            _items = (await AnalyticsService.GetAsync(_pageSize, symbol)).ToList();
            _lastUpdated = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ApplySort() => StateHasChanged();

    private async Task OnAutoRefreshChangedAsync()
    {
        await StopAutoRefresh();
        if (_autoRefresh)
            StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        _autoRefreshCts = new CancellationTokenSource();
        var token = _autoRefreshCts.Token;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(_autoRefreshSec));
            while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token).ConfigureAwait(false))
            {
                await InvokeAsync(async () =>
                {
                    await Load();
                    StateHasChanged();
                });
            }
        }, token);
    }

    private async Task StopAutoRefresh()
    {
        if (_autoRefreshCts is not null)
        {
            await _autoRefreshCts.CancelAsync();
            _autoRefreshCts.Dispose();
            _autoRefreshCts = null;
        }
    }

    private async Task Clear()
    {
        _clearing = true;
        try
        {
            await AnalyticsService.ClearAsync();
            _items.Clear();
            _lastUpdated = null;
        }
        finally
        {
            _clearing = false;
        }
    }

    public async ValueTask DisposeAsync() => await StopAutoRefresh();
}

