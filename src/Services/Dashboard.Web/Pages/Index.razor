@page "/"
@inject TradingApp.Dashboard.Web.Services.AnalyticsService AnalyticsService
@implements IAsyncDisposable

<PageTitle>TradingApp Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4">

    
    <MudPaper Elevation="4" Class="pa-4 mb-4 rounded-lg">
        <MudGrid Justify="Justify.SpaceBetween" Class="align-center">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h5" Color="Color.Primary" GutterBottom="false">
                    📈 TradingApp Dashboard
                </MudText>
                @if (_lastUpdated.HasValue)
                {
                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                        Last updated: @_lastUpdated.Value.ToLocalTime().ToString("HH:mm:ss")
                        &nbsp;|&nbsp; @_items.Count records
                    </MudText>
                }
            </MudItem>
            <MudItem xs="12" md="6">
                <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudSwitch T="bool" @bind-Value="_autoRefresh" Color="Color.Primary"
                               Label="@($"Auto-refresh ({_autoRefreshSec}s)")"
                               @bind-Value:after="OnAutoRefreshChangedAsync" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadAsync" Disabled="_loading" Size="Size.Small">
                        @(_loading ? "Loading…" : "Refresh")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                               StartIcon="@Icons.Material.Filled.DeleteSweep"
                               OnClick="ClearAsync" Disabled="(_clearing || _loading)" Size="Size.Small">
                        @(_clearing ? "Clearing…" : "Clear index")
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    
    <MudPaper Elevation="2" Class="pa-4 mb-4 rounded-lg">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Symbol" @bind-Value="_selectedSymbol"
                           @bind-Value:after="LoadAsync" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value='@("")'>All symbols</MudSelectItem>
                    @foreach (var s in _symbols)
                    {
                        <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int" Label="Rows" @bind-Value="_pageSize"
                           @bind-Value:after="LoadAsync" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="25">25</MudSelectItem>
                    <MudSelectItem T="int" Value="50">50</MudSelectItem>
                    <MudSelectItem T="int" Value="100">100</MudSelectItem>
                    <MudSelectItem T="int" Value="200">200</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Sort by" @bind-Value="_sortField"
                           @bind-Value:after="ApplySortAsync" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value='"windowStartUtc"'>Window Start ↓ (newest)</MudSelectItem>
                    <MudSelectItem T="string" Value='"symbol"'>Symbol</MudSelectItem>
                    <MudSelectItem T="string" Value='"lastPrice"'>Last Price</MudSelectItem>
                    <MudSelectItem T="string" Value='"volume"'>Volume</MudSelectItem>
                    <MudSelectItem T="string" Value='"tradesCount"'>Trades</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
                  CloseIconClicked="@(() => _error = null)">
            @_error
        </MudAlert>
    }

    
    <MudTable T="TradingApp.Contracts.Events.AggregatedMarketAnalyticsEvent"
              Items="_sortedItems"
              Dense="true" Hover="true" Striped="true"
              Loading="_loading" LoadingProgressColor="Color.Primary"
              Elevation="4" Class="rounded-lg">
        <HeaderContent>
            <MudTh>Symbol</MudTh>
            <MudTh Style="text-align:right">Open</MudTh>
            <MudTh Style="text-align:right; color:#4caf50">High</MudTh>
            <MudTh Style="text-align:right; color:#f44336">Low</MudTh>
            <MudTh Style="text-align:right">Last</MudTh>
            <MudTh Style="text-align:right">Volume</MudTh>
            <MudTh Style="text-align:right">Trades</MudTh>
            <MudTh>Window Start (UTC)</MudTh>
            <MudTh>Window End (UTC)</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Symbol">
                <MudText Color="Color.Primary" Typo="Typo.body2" Style="font-weight:600">
                    @context.Symbol
                </MudText>
            </MudTd>
            <MudTd DataLabel="Open" Style="text-align:right">@context.OpenPrice.ToString("F2")</MudTd>
            <MudTd DataLabel="High" Style="text-align:right; color:#4caf50">@context.HighPrice.ToString("F2")</MudTd>
            <MudTd DataLabel="Low"  Style="text-align:right; color:#f44336">@context.LowPrice.ToString("F2")</MudTd>
            <MudTd DataLabel="Last" Style="@($"text-align:right; font-weight:600; color:{(context.LastPrice >= context.OpenPrice ? "#4caf50" : "#f44336")}")">
                @context.LastPrice.ToString("F2")
            </MudTd>
            <MudTd DataLabel="Volume" Style="text-align:right">@context.Volume.ToString("F4")</MudTd>
            <MudTd DataLabel="Trades" Style="text-align:right">@context.TradesCount</MudTd>
            <MudTd DataLabel="Window Start">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                    @context.WindowStartUtc.ToString("MM/dd HH:mm:ss")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Window End">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                    @context.WindowEndUtc.ToString("MM/dd HH:mm:ss")
                </MudText>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="padding:24px; color:var(--mud-palette-text-secondary)">
                No data. Make sure the pipeline is running.
            </MudText>
        </NoRecordsContent>
    </MudTable>

</MudContainer>

@code {
    private bool _loading = true;
    private bool _clearing = false;
    private bool _autoRefresh = false;
    private readonly int _autoRefreshSec = 10;
    private int _pageSize = 100;
    private string _selectedSymbol = "";
    private string _sortField = "windowStartUtc";
    private DateTime? _lastUpdated;
    private string? _error;
    private List<TradingApp.Contracts.Events.AggregatedMarketAnalyticsEvent> _items = new();
    private List<string> _symbols = new();
    private CancellationTokenSource? _autoRefreshCts;

    private IEnumerable<TradingApp.Contracts.Events.AggregatedMarketAnalyticsEvent> _sortedItems =>
        _sortField switch
        {
            "symbol"      => _items.OrderBy(x => x.Symbol),
            "lastPrice"   => _items.OrderByDescending(x => x.LastPrice),
            "volume"      => _items.OrderByDescending(x => x.Volume),
            "tradesCount" => _items.OrderByDescending(x => x.TradesCount),
            _             => _items
        };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _symbols = (await AnalyticsService.GetSymbolsAsync()).OrderBy(s => s).ToList();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _loading = false;
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var symbol = string.IsNullOrWhiteSpace(_selectedSymbol) ? null : _selectedSymbol;
            _items = (await AnalyticsService.GetAsync(_pageSize, symbol)).ToList();
            _lastUpdated = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private Task ApplySortAsync()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OnAutoRefreshChangedAsync()
    {
        await StopAutoRefreshAsync();
        if (_autoRefresh)
            StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        _autoRefreshCts = new CancellationTokenSource();
        var token = _autoRefreshCts.Token;
        _ = Task.Run(async () =>
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(_autoRefreshSec));
            try
            {
                while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadAsync();
                        StateHasChanged();
                    });
                }
            }
            catch (OperationCanceledException) { }
        }, token);
    }

    private async Task StopAutoRefreshAsync()
    {
        if (_autoRefreshCts is not null)
        {
            await _autoRefreshCts.CancelAsync();
            _autoRefreshCts.Dispose();
            _autoRefreshCts = null;
        }
    }

    private async Task ClearAsync()
    {
        _clearing = true;
        try
        {
            await AnalyticsService.ClearAsync();
            _items.Clear();
            _lastUpdated = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _clearing = false;
        }
    }

    public async ValueTask DisposeAsync() => await StopAutoRefreshAsync();
}
