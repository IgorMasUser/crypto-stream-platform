@page "/"
@attribute [Authorize]

<PageTitle>TradingApp Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="pa-4">

    @* Header *@
    <MudPaper Elevation="4" Class="pa-4 mb-4 rounded-lg">
        <MudGrid Justify="Justify.SpaceBetween" Class="align-center">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.h4" Color="Color.Primary" Style="font-weight:700; letter-spacing:-0.5px">
                    📈 TradingApp Dashboard
                </MudText>
                @if (_lastUpdated.HasValue)
                {
                    <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                        Last updated: @_lastUpdated.Value.ToLocalTime().ToString("HH:mm:ss")
                        &nbsp;|&nbsp; @_items.Count records
                    </MudText>
                }
            </MudItem>
            <MudItem xs="12" md="6">
                <MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudSwitch T="bool" @bind-Value="_autoRefresh" Color="Color.Primary"
                               Label="@($"Auto-refresh ({_autoRefreshSec}s)")"
                               @bind-Value:after="OnAutoRefreshChangedAsync" />
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="LoadAsync" Disabled="_loading" Size="Size.Small">
                        @(_loading ? "Loading…" : "Refresh")
                    </MudButton>
                </MudStack>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* KPI cards *@
    @if (_items.Any())
    {
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg" Style="border-left:4px solid #4caf50; min-height:90px">
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary)">BIGGEST GAINER</MudText>
                    @if (_kpiBiggestGainer is not null)
                    {
                        <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight:700; line-height:1.2">
                            @_kpiBiggestGainer.Symbol
                        </MudText>
                        <MudText Style="color:#4caf50; font-size:1.15rem; font-weight:700">
                            @_kpiBiggestGainer.ChangePercent.ToString("+0.00;-0.00;0.00")%
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                            Last: @_kpiBiggestGainer.LastPrice.ToString("F2")
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg" Style="border-left:4px solid #f44336; min-height:90px">
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary)">BIGGEST LOSER</MudText>
                    @if (_kpiBiggestLoser is not null)
                    {
                        <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight:700; line-height:1.2">
                            @_kpiBiggestLoser.Symbol
                        </MudText>
                        <MudText Style="color:#f44336; font-size:1.15rem; font-weight:700">
                            @_kpiBiggestLoser.ChangePercent.ToString("+0.00;-0.00;0.00")%
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                            Last: @_kpiBiggestLoser.LastPrice.ToString("F2")
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudPaper Elevation="2" Class="pa-4 rounded-lg" Style="border-left:4px solid #7c4dff; min-height:90px">
                    <MudText Typo="Typo.overline" Style="color:var(--mud-palette-text-secondary)">MOST ACTIVE</MudText>
                    @if (_kpiMostActive is not null)
                    {
                        <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight:700; line-height:1.2">
                            @_kpiMostActive.Symbol
                        </MudText>
                        <MudText Style="color:#7c4dff; font-size:1.15rem; font-weight:700">
                            @_kpiMostActive.TradesCount trades
                        </MudText>
                        <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                            Vol: @_kpiMostActive.Volume.ToString("F4")
                        </MudText>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>

        @* Top Gainers / Losers *@
        <MudGrid Spacing="3" Class="mb-4">
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pa-3 rounded-lg">
                    <MudText Typo="Typo.subtitle2" Style="color:#4caf50; margin-bottom:6px; font-weight:700">
                        📈 Top Gainers
                    </MudText>
                    @foreach (var item in _topGainers)
                    {
                        <div style="display:flex; justify-content:space-between; align-items:center; padding:3px 0; border-bottom:1px solid rgba(255,255,255,0.05)">
                            <MudText Typo="Typo.body2" Color="Color.Primary" Style="font-weight:600">@item.Symbol</MudText>
                            <MudText Typo="Typo.body2" Style="color:#4caf50; font-weight:600">
                                @item.ChangePercent.ToString("+0.00;-0.00;0.00")%
                            </MudText>
                        </div>
                    }
                </MudPaper>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudPaper Elevation="2" Class="pa-3 rounded-lg">
                    <MudText Typo="Typo.subtitle2" Style="color:#f44336; margin-bottom:6px; font-weight:700">
                        📉 Top Losers
                    </MudText>
                    @foreach (var item in _topLosers)
                    {
                        <div style="display:flex; justify-content:space-between; align-items:center; padding:3px 0; border-bottom:1px solid rgba(255,255,255,0.05)">
                            <MudText Typo="Typo.body2" Color="Color.Primary" Style="font-weight:600">@item.Symbol</MudText>
                            <MudText Typo="Typo.body2" Style="color:#f44336; font-weight:600">
                                @item.ChangePercent.ToString("+0.00;-0.00;0.00")%
                            </MudText>
                        </div>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
    }

    @* Filters *@
    <MudPaper Elevation="2" Class="pa-4 mb-4 rounded-lg">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudSelect T="string" Label="Symbol" @bind-Value="_selectedSymbol"
                           @bind-Value:after="LoadAsync" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="string" Value='@("")'>All symbols</MudSelectItem>
                    @foreach (var s in _symbols)
                    {
                        <MudSelectItem T="string" Value="@s">@s</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="int" Label="Rows" @bind-Value="_pageSize"
                           @bind-Value:after="LoadAsync" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="int" Value="25">25</MudSelectItem>
                    <MudSelectItem T="int" Value="50">50</MudSelectItem>
                    <MudSelectItem T="int" Value="100">100</MudSelectItem>
                    <MudSelectItem T="int" Value="200">200</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="SortField" Label="Sort by" @bind-Value="_sortField"
                           @bind-Value:after="ApplySortAsync" Dense="true" Variant="Variant.Outlined">
                    <MudSelectItem T="SortField" Value="SortField.WindowStartUtc">Window Start ↓ (newest)</MudSelectItem>
                    <MudSelectItem T="SortField" Value="SortField.Symbol">Symbol</MudSelectItem>
                    <MudSelectItem T="SortField" Value="SortField.LastPrice">Last Price</MudSelectItem>
                    <MudSelectItem T="SortField" Value="SortField.Volume">Volume</MudSelectItem>
                    <MudSelectItem T="SortField" Value="SortField.TradesCount">Trades</MudSelectItem>
                    <MudSelectItem T="SortField" Value="SortField.ChangePercent">% Change</MudSelectItem>
                    <MudSelectItem T="SortField" Value="SortField.RangePercent">Range %</MudSelectItem>
                </MudSelect>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @* Error *@
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
                  CloseIconClicked="@(() => _error = null)">
            @_error
        </MudAlert>
    }

    @* Table *@
    <MudTable T="MarketAnalyticsDto"
              Items="_sortedItems"
              Dense="true" Hover="true"
              RowStyleFunc="@((_, i) => i % 2 == 0 ? "background:rgba(99,102,241,0.08)" : "background:rgba(255,255,255,0.02)")"
              Loading="_loading" LoadingProgressColor="Color.Primary"
              Elevation="4" Class="rounded-lg">
        <HeaderContent>
            <MudTh>Symbol</MudTh>
            <MudTh Style="text-align:right">Open</MudTh>
            <MudTh Style="text-align:right; color:#4caf50">High</MudTh>
            <MudTh Style="text-align:right; color:#f44336">Low</MudTh>
            <MudTh Style="text-align:right">Last</MudTh>
            <MudTh Style="text-align:right">% Change</MudTh>
            <MudTh Style="text-align:right; color:#ff9800">Range %</MudTh>
            <MudTh Style="text-align:right">Volume</MudTh>
            <MudTh Style="text-align:right">Trades</MudTh>
            <MudTh>Window Start (UTC)</MudTh>
            <MudTh>Window End (UTC)</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Symbol">
                <MudText Color="Color.Primary" Typo="Typo.body2" Style="font-weight:600">
                    @context.Symbol
                </MudText>
            </MudTd>
            <MudTd DataLabel="Open" Style="text-align:right">@context.OpenPrice.ToString("F2")</MudTd>
            <MudTd DataLabel="High" Style="text-align:right; color:#4caf50">@context.HighPrice.ToString("F2")</MudTd>
            <MudTd DataLabel="Low"  Style="text-align:right; color:#f44336">@context.LowPrice.ToString("F2")</MudTd>
            <MudTd DataLabel="Last" Style="@($"text-align:right; font-weight:600; color:{(context.LastPrice >= context.OpenPrice ? "#4caf50" : "#f44336")}")">
                @context.LastPrice.ToString("F2")
            </MudTd>
            <MudTd DataLabel="% Change" Style="text-align:right">
                <MudText Typo="Typo.body2" Style="@($"font-weight:700; color:{(context.ChangePercent >= 0 ? "#4caf50" : "#f44336")}")">
                    @context.ChangePercent.ToString("+0.00;-0.00;0.00")%
                </MudText>
            </MudTd>
            <MudTd DataLabel="Range %" Style="text-align:right; color:#ff9800">
                @context.RangePercent.ToString("F2")%
            </MudTd>
            <MudTd DataLabel="Volume" Style="text-align:right">@context.Volume.ToString("F4")</MudTd>
            <MudTd DataLabel="Trades" Style="text-align:right">@context.TradesCount</MudTd>
            <MudTd DataLabel="Window Start">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                    @context.WindowStartUtc.ToString("MM/dd HH:mm:ss")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Window End">
                <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary)">
                    @context.WindowEndUtc.ToString("MM/dd HH:mm:ss")
                </MudText>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Style="padding:24px; color:var(--mud-palette-text-secondary)">
                No data. Make sure the pipeline is running.
            </MudText>
        </NoRecordsContent>
    </MudTable>

</MudContainer>
