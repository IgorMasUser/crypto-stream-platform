{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=marketanalytics;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "marketanalytics-service",
    "Consumer": {
      "Enabled": true,
      "Topic": "raw-market-trades",
      "GroupId": "marketanalytics-service",
      "AutoOffsetReset": "Earliest",
      "EnableAutoCommit": true
    }
  }
}

